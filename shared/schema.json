  "eval_config": {
    "extraction": {
      "scoring": {
        "numeric": {
          "tolerance_abs": 1,
          "tolerance_pct": 0.05
        },
        "boolean": "exact_match",
        "date": "fuzzy_match",
        "categorical": "normalized_match",
        "free_text": "llm_judge",
        "list": "per_item_precision_recall"
      },
      "judge_model": "gpt-oss:120b",
      "models": [
        "glm-5.2",
        "deepseek-v4-pro:0813",
        "qwen3.5:397b"
      ]
    },
    "retrieval": {
      "strategies": [
        "bm25",
        "dense",
        "hybrid"
      ],
      "metrics": [
        "hit@k",
        "recall@k",
        "mrr"
      ],
      "k": 5,
      "embedding_backend": "http://127.0.0.1:11434",
      "embedding_fallback": "sentence-transformers/all-MiniLM-L6-v2"
    }
  },
  "aggregation": {
    "metrics": [
      "precision",
      "recall",
      "f1"
    ],
    "per_field": true,
    "per_document": true,
    "baseline_file": "evals/baseline.json",
    "regression_tolerance": 0.03
  }
